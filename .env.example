# ---- Node app (npm start) ----
PORT=3000
# n8n webhook the app calls. Use the *Production* URL (workflow must be active).
N8N_WEBHOOK_URL=http://localhost:5678/webhook/prompt

# ---- n8n (docker compose) ----
# Encrypts credentials stored in n8n. Generate: openssl rand -base64 32
# Do not change it after saving credentials, or they become unreadable.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
